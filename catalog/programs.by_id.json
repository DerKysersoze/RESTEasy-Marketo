  "permission": "Read-Only Asset",
  "params": {
    "path": [
      {
        "name": "id",
        "label": "Program ID",
        "required": true,
        "type": "integer",
        "hint": "Find it via Get Programs.",
        "example": "55"
      }
    ],
    "query": [],
    "body": null
  },
  "response": {
    "shape": "object",
    "exportable": false,
    "description": "The program's name, status, and metadata."
  },
  "notes": []
}
